// Prisma schema — lumora data model.
//
// Auth domain: `User`, `RefreshToken`, `EmailVerification`, `PasswordReset`
// use hard deletes — removing a user cascades to its tokens and verification
// records. There is no soft-delete convention for auth data; expired tokens
// are pruned rather than flagged.
//
// Marketplace domain: identity (`User`) and commerce (`Order`) tables are
// delivered by their own changes. Cross-scope references (`userId`,
// `orderId`) are plain indexed String columns instead of Prisma relations so
// every model here migrates cleanly on its own. Wire the relations up once
// those tables land.
//
// Orphaned media cleanup: `Media` rows are only created alongside an upload.
// When an artwork, portfolio item, or deliverable is deleted, its junction
// rows cascade but the `Media` row itself is retained; a background job
// should sweep `Media` rows older than N days that appear in no junction
// table and no `coverMediaId` reference before deleting the object from S3.
//
// DATABASE_URL is provided by src/config/env.ts at runtime; the CLI needs
// it exported in the shell (or via node --env-file=.env).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// System-wide identity roles.
enum Role {
  USER
  ARTIST
  ADMIN
}

/// How a media object is used.
enum MediaType {
  IMAGE
  DIGITAL_FILE
}

/// Marketplace categories for artworks.
enum ArtworkCategory {
  ART
  ILLUSTRATION
  GRAPHIC_DESIGN
  PHOTOGRAPHY
  DIGITAL_PAINTING
  THREE_D_ART
  ANIMATION
  UX_UI
  MUSIC
  WRITING
  OTHER
}

/// Artist verification workflow state.
enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Core identity model. `email` and `username` are unique (enforced as unique indexes).
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  username      String   @unique
  role          Role     @default(USER)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refreshTokens      RefreshToken[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]

  @@index([email])
  @@index([username])
}

/// Long-lived refresh token; `token` is unique for direct lookups during rotation.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time email verification links.
model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time password reset links.
model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Stellar public key linked to a user account (one wallet per user).
model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  publicKey String   @unique
  network   String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([publicKey])
  @@index([network])
}

/// Short-lived signing nonce; expires and is consumed after use.
model StellarNonce {
  id        String   @id @default(uuid())
  publicKey String
  nonce     String   @unique
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([publicKey])
}

/// Optional creator profile — not every user has one.
model ArtistProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  bio                String?
  location           String?
  hourlyRate         Decimal?           @db.Decimal(12, 2)
  availability       Boolean            @default(true)
  skills             Json?
  socialLinks        Json?
  coverImage         String?
  avatarUrl          String?
  verified           Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

/// Follow relationship. Enforced unique per (follower, following) pair;
/// self-follows are rejected at the application layer (see service layer).
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

/// Controlled skill taxonomy for artist profiles.
model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  category  String?
  createdAt DateTime @default(now())
}

/// Showcase item (not for sale).
model PortfolioItem {
  id           String           @id @default(uuid())
  userId       String
  title        String
  description  String?
  tags         Json?
  coverMediaId String?
  order        Int              @default(0)
  published    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  media        PortfolioMedia[]

  @@index([userId])
  @@index([userId, published])
}

/// Artwork listed for sale. `category` is an enum; the separate `Category`
/// table carries the browsable taxonomy.
model Artwork {
  id           String          @id @default(uuid())
  userId       String
  title        String
  description  String?
  category     ArtworkCategory
  tags         Json?
  coverMediaId String?
  published    Boolean         @default(false)
  sold         Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  media        ArtworkMedia[]

  @@index([userId])
  @@index([category])
  @@index([userId, published])
}

/// Browsable category taxonomy. One level of nesting (parent → child).
model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  createdAt DateTime   @default(now())

  @@index([parentId])
}

/// Flat tag vocabulary (unique slug).
model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
}

/// Metadata for every uploaded file (S3 bucket/key + dimensions).
model Media {
  id           String             @id @default(uuid())
  userId       String
  type         MediaType
  bucket       String
  key          String             @unique
  mimeType     String
  size         BigInt             @db.BigInt
  width        Int?
  height       Int?
  createdAt    DateTime           @default(now())
  artworks     ArtworkMedia[]
  portfolio    PortfolioMedia[]
  deliverables OrderDeliverable[]

  @@index([userId])
}

/// Artwork ↔ media join with editable sort order.
model ArtworkMedia {
  artworkId String
  mediaId   String
  sort      Int     @default(0)
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([artworkId, mediaId])
  @@index([mediaId])
}

/// Portfolio item ↔ media join with editable sort order.
model PortfolioMedia {
  portfolioItemId String
  mediaId         String
  sort            Int           @default(0)
  portfolioItem   PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  media           Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([portfolioItemId, mediaId])
  @@index([mediaId])
}

/// Deliverable media attached to an order. `orderId` references the Order
/// table delivered elsewhere (plain indexed string until then).
model OrderDeliverable {
  orderId String
  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([orderId, mediaId])
  @@index([mediaId])
}